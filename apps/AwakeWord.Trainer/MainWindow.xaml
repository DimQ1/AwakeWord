<Window x:Class="AwakeWord.Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwakeWord Trainer — Custom Wake Word Model" 
        Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Train Custom Wake Word Model" 
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,8"
                   Foreground="#1E3A5F"/>

        <!-- Step 1: Configuration -->
        <GroupBox Grid.Row="1" Header="1. Configuration" Margin="0,4" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wake Word Name:" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WakeWordNameBox" 
                         Text="hey_custom" Margin="8,4" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Models Directory:" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ModelsDirBox" 
                         Text="models" Margin="8,4" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." 
                        Click="BrowseModelsDir_Click" Width="80"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Output Model Path:" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputPathBox" 
                         Text="models\hey_custom.onnx" Margin="8,4" VerticalContentAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." 
                        Click="BrowseOutputPath_Click" Width="80"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Epochs:" Margin="0,0,8,0"/>
                    <TextBox x:Name="EpochsBox" Text="100" Width="60" 
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Learning Rate:" Margin="16,0,8,0"/>
                    <TextBox x:Name="LearningRateBox" Text="0.0001" Width="80" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Step 2: Audio Samples -->
        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Positive Samples -->
            <GroupBox Grid.Column="0" Header="2a. Positive Samples (contains wake word)" 
                      Margin="0,0,4,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="PositiveFilesList" MinHeight="80"
                             SelectionMode="Extended"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Add Files..." Click="AddPositiveFiles_Click"/>
                        <Button Content="Remove" Click="RemovePositiveFiles_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="RecordPositiveBtn" Content="🎙 Record" 
                                Click="RecordPositive_Click" Background="#E8F5E9"/>
                        <ProgressBar x:Name="PositiveLevelBar" Width="120" Height="16"
                                     Margin="8,0,0,0" Maximum="1" Value="0"
                                     Foreground="#4CAF50"/>
                        <TextBlock x:Name="PositiveRecordingStatus" Margin="8,0,0,0"
                                   Foreground="#666" Text=""/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Negative Samples -->
            <GroupBox Grid.Column="1" Header="2b. Negative Samples (no wake word)" 
                      Margin="4,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="NegativeFilesList" MinHeight="80"
                             SelectionMode="Extended"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Add Files..." Click="AddNegativeFiles_Click"/>
                        <Button Content="Remove" Click="RemoveNegativeFiles_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="RecordNegativeBtn" Content="🎙 Record" 
                                Click="RecordNegative_Click" Background="#FFF3E0"/>
                        <ProgressBar x:Name="NegativeLevelBar" Width="120" Height="16"
                                     Margin="8,0,0,0" Maximum="1" Value="0"
                                     Foreground="#FF9800"/>
                        <TextBlock x:Name="NegativeRecordingStatus" Margin="8,0,0,0"
                                   Foreground="#666" Text=""/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Step 3: Train -->
        <GroupBox Grid.Row="3" Header="3. Train Model" Margin="0,4" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TrainButton" Content="▶ Start Training" 
                            Click="Train_Click" FontWeight="Bold" FontSize="14"
                            Background="#1E88E5" Foreground="White" Padding="20,8"
                            MinWidth="160"/>
                    <Button x:Name="CancelButton" Content="Cancel" 
                            Click="Cancel_Click" IsEnabled="False"/>
                    <TextBlock x:Name="TrainingStatusText" Margin="16,0,0,0"
                               FontSize="13" Foreground="#333"/>
                </StackPanel>
                <ProgressBar x:Name="TrainingProgressBar" Height="20" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#1E88E5"/>
            </StackPanel>
        </GroupBox>

        <!-- Step 4: Test -->
        <GroupBox Grid.Row="4" Header="4. Test Trained Model" Margin="0,4" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestButton" Content="🔊 Test with Microphone" 
                        Click="Test_Click" IsEnabled="False" Background="#E8F5E9"/>
                <Button x:Name="EndTestButton" Content="⏹ End Test"
                        Click="EndTest_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="TestFileButton" Content="📁 Test with File" 
                        Click="TestFile_Click" IsEnabled="False"/>
                <TextBlock x:Name="TestResultText" Margin="16,0,0,0" FontSize="13"/>
            </StackPanel>
        </GroupBox>

        <!-- Log -->
        <GroupBox Grid.Row="5" Header="Log" Margin="0,4,0,0" Grid.RowSpan="2">
            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="#1E1E1E" Foreground="#D4D4D4" Padding="8"
                     TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
