{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AwakeWord.TestApp",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/AwakeWord.TestApp/bin/Debug/net10.0/AwakeWord.TestApp.dll",
            "args": [
                "--models-dir",
                "models",
                "--wake-word",
                "custom"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run AwakeWord.TestApp (custom threshold)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/AwakeWord.TestApp/bin/Debug/net10.0/AwakeWord.TestApp.dll",
            "args": [
                "--models-dir",
                "models",
                "--threshold",
                "0.3"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run AwakeWord.Trainer",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/AwakeWord.Trainer/bin/Debug/net10.0-windows/AwakeWord.Trainer.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Debug Unit Tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/tests/AwakeWord.Core.Tests/AwakeWord.Core.Tests.csproj",
                "--logger:console;verbosity=detailed"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Debug Current Test",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/tests/AwakeWord.Core.Tests/AwakeWord.Core.Tests.csproj",
                "--filter",
                "FullyQualifiedName~${selectedText}",
                "--logger:console;verbosity=detailed"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
